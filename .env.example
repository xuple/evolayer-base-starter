APP_NAME="EvoLayer Base"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_DEV_SERVER_PORT=
VITE_DEV_SERVER_ORIGIN=

# ---------------------------------------------------------------------------
# Public site identity and link previews
# ---------------------------------------------------------------------------
# SITE_NAME falls back to EVOLAYER_BASE_BRAND_NAME, then APP_NAME, when blank.
SITE_NAME=
# SITE_URL falls back to APP_URL when blank. Use only when the public canonical origin differs.
SITE_URL=
# SITE_TITLE_TEMPLATE falls back to "%s | <site name>" when blank.
SITE_TITLE_TEMPLATE=
SITE_DESCRIPTION="AI, ontology, and block-first Laravel starter for modern product teams."
# Open Graph locale uses language_TERRITORY format, e.g. en_GB.
SITE_OG_LOCALE=en_GB
# Quote hex colours because # starts comments in dotenv syntax.
SITE_THEME_COLOR="#064e3b"
SITE_ROBOTS_DEFAULT="index,follow"

# Optional cache-busting token appended (?v=) to public asset URLs built via the
# frontend useVersionedAsset() helper (e.g. marketing images behind a CDN).
# Bump on redeploy to force clients/CDNs to refetch replaced files.
SITE_ASSET_VERSION=

# Default social preview image
# May be a leading-slash path or a full absolute URL.
SOCIAL_IMAGE="/social/og-default.png"
SOCIAL_IMAGE_ALT="EvoLayer Base preview image"
SOCIAL_IMAGE_WIDTH=1200
SOCIAL_IMAGE_HEIGHT=630
SOCIAL_IMAGE_TYPE="image/png"
# Optional cache-busting token appended when present.
SOCIAL_IMAGE_VERSION=

# Optional X / Twitter-compatible handles
SOCIAL_TWITTER_SITE=
SOCIAL_TWITTER_CREATOR=

# Optional structured data
SITE_JSONLD_ENABLED=true
# May be a leading-slash path or a full absolute URL.
SITE_LOGO=
# Optional local-business JSON-LD node. Blank SITE_JSONLD_TYPE keeps output as
# WebSite (+ Organization when SITE_LOGO is set); set it to a schema.org type
# (comma-separate several, e.g. "LocalBusiness,HomeAndConstructionBusiness") to
# emit a business node with the contact fields below. SITE_JSONLD_SAME_AS is a
# comma-separated list of profile URLs.
SITE_JSONLD_TYPE=
SITE_JSONLD_TELEPHONE=
SITE_JSONLD_EMAIL=
SITE_JSONLD_AREA_SERVED=
SITE_JSONLD_PRICE_RANGE=
SITE_JSONLD_SAME_AS=

# ---------------------------------------------------------------------------
# EvoLayer Base
# ---------------------------------------------------------------------------
# This starter ships in "kitchen-sink" posture: every example surface is
# enabled so you can see the full demo surface immediately.
#
# EVOLAYER_BASE_EXAMPLE_* — bundled demo surfaces. Setting one to false
# drops the feature's routes and hides its sidebar entry; the shared
# evolayer.base.examples prop still carries the key but reports it as
# false, so client code can branch on it (the key does not disappear).
EVOLAYER_BASE_EXAMPLE_MARKETING_PAGES=true
EVOLAYER_BASE_EXAMPLE_THREAD_STUDIO=true
EVOLAYER_BASE_EXAMPLE_PRD_STUDIO=true
EVOLAYER_BASE_EXAMPLE_ADMIN_INBOX=true
EVOLAYER_BASE_EXAMPLE_CONTACT_AI=true
EVOLAYER_BASE_EXAMPLE_VOICE_INPUT=true
EVOLAYER_BASE_EXAMPLE_AI_TEXT_FIELD=true

# EVOLAYER_BASE_FEATURE_* — substrate capabilities. These gate
# behaviour, not surface area: there are no routes or nav entries to
# drop. Setting one to false turns the underlying capability off, and
# the shared evolayer.base.features prop flips the key to false.
# CONTACT_ATTACHMENTS requires spatie/laravel-medialibrary (shipped).
EVOLAYER_BASE_FEATURE_CONTACT_ATTACHMENTS=true

# EVOLAYER_BASE_BRAND_* — branding for the public explainer (evolayer/base)
# and head metadata, read via config('evolayer.base.brand') and the useBrand()
# hook. Override these to rebrand the managed page without editing the file.
EVOLAYER_BASE_BRAND_NAME="EvoLayer Base"
EVOLAYER_BASE_BRAND_TAGLINE="A fully working AI application layer for the official Laravel AI SDK."
EVOLAYER_BASE_BRAND_DESCRIPTION="Start from a working application: Laravel auth, typed routes, structured AI workflows, admin screens, ontology tooling, and local verification commands already wired together."

# AI providers. ThreadStudio's runtime-approved (directly-verified) providers are
# Gemini (default) and OpenAI — set a key for whichever you point
# AI_THREAD_STUDIO_PROVIDER at. Run
# `php artisan evolayer:ai:stream-check gemini` to verify structured streaming.
AI_DEFAULT_PROVIDER=gemini
AI_THREAD_STUDIO_PROVIDER=gemini
AI_THREAD_STUDIO_TIMEOUT=90

GEMINI_API_KEY=
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_CHAT_MODEL=gemini-flash-latest

# OpenAI is a runtime-approved ThreadStudio provider; OPENAI_CHAT_MODEL sets its
# default model (the SDK has no usable default for ThreadStudio without it).
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Anthropic is diagnostic-eligible but blocked for ThreadStudio runtime /
# pending re-verification — it is NOT runtime-approved for ThreadStudio
# (structured streaming currently emits no usable deltas). The key + model let
# you exercise it via
# `php artisan evolayer:ai:smoke-test anthropic`, not select it in ThreadStudio.
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001

# Optional OpenAI-compatible router-backed providers — diagnostic / probe candidates
# (not runtime-approved for ThreadStudio). Exercise via the smoke/probe commands.
# NVIDIA_API_KEY=
# NVIDIA_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_CHAT_MODEL=deepseek-ai/deepseek-v4-pro
#
# OPENCODE_API_KEY=
# OPENCODE_URL=https://opencode.ai/zen/go/v1
# OPENCODE_CHAT_MODEL=kimi-k2.6
#
# OPENROUTER_API_KEY=
# OPENROUTER_URL=https://openrouter.ai/api/v1
# OPENROUTER_CHAT_MODEL=openrouter/auto
