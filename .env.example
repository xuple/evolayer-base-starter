APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# EvoLayer Base
# ---------------------------------------------------------------------------
# This starter ships in "kitchen-sink" posture: every example feature is
# enabled so you can see the full surface immediately. Flip any of these to
# false (or delete the line) to drop that feature's routes, nav entry, and
# shared props. Disabling a feature changes nothing else.
EVOLAYER_BASE_EXAMPLE_MARKETING_PAGES=true
EVOLAYER_BASE_EXAMPLE_THREAD_STUDIO=true
EVOLAYER_BASE_EXAMPLE_PRD_STUDIO=true
EVOLAYER_BASE_EXAMPLE_ADMIN_INBOX=true
EVOLAYER_BASE_EXAMPLE_CONTACT_AI=true
EVOLAYER_BASE_EXAMPLE_VOICE_INPUT=true
EVOLAYER_BASE_EXAMPLE_AI_TEXT_FIELD=true

# Requires spatie/laravel-medialibrary (shipped with this starter). Set false
# to disable contact-form attachment processing.
EVOLAYER_BASE_FEATURE_CONTACT_ATTACHMENTS=true

# AI providers. ThreadStudio and the other AI features default to Gemini —
# set a key for whichever provider you point AI_DEFAULT_PROVIDER at. Run
# `php artisan ai:stream-smoke gemini` to verify structured streaming.
AI_DEFAULT_PROVIDER=gemini
AI_THREAD_STUDIO_PROVIDER=gemini
AI_THREAD_STUDIO_TIMEOUT=90

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3-flash-preview

OPENAI_API_KEY=

ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5-20251001
