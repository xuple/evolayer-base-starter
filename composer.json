{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "xuple/evolayer-base-starter",
    "type": "project",
    "description": "EvoLayer Base starter — the Laravel React Inertia starter kit with the EvoLayer AI / ontology / blocks layer pre-wired. Part of the EvoDevOps starter-kit family.",
    "keywords": [
        "evolayer",
        "evodevops",
        "xuple",
        "laravel",
        "inertia",
        "react",
        "ai",
        "starter-kit"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "xuple/evolayer-base": "^0.1",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/chisel": "^0.1.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.7",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "spatie/laravel-medialibrary": "^11.22",
        "spatie/laravel-tags": "^4.11"
    },
    "require-dev": {
        "cweagans/composer-patches": "^2.0",
        "fakerphp/faker": "^1.24",
        "laravel/boost": "^2.2",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^12.5.23"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --seed --force",
            "@php artisan route:clear --ansi",
            "@php artisan wayfinder:generate --with-form --no-interaction",
            "@php artisan evolayer:ontology:compile --no-erd --no-interaction",
            "npm install",
            "npm run build"
        ],
        "evolayer:resync": [
            "@php artisan vendor:publish --tag=evolayer-base-frontend --force",
            "@php artisan vendor:publish --tag=evolayer-base-config --force",
            "@php artisan vendor:publish --tag=evolayer-base-ontology --force",
            "@php artisan route:clear --ansi",
            "@php artisan wayfinder:generate --with-form --no-interaction",
            "@php artisan evolayer:ontology:compile --no-erd --no-interaction",
            "@bash scripts/resync-starter-pages-check.sh"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve --host=localhost\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "lint": [
            "pint"
        ],
        "lint:check": [
            "pint --test"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "vendor/bin/phpunit"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan boost:update --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --seed --force",
            "@php artisan route:clear --ansi",
            "@php artisan wayfinder:generate --with-form --no-interaction",
            "@php artisan evolayer:ontology:compile --no-erd --no-interaction"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "patches": {
            "laravel/ai": {
                "Enable structured output streaming (until upstream lands the fix)": "patches/laravel-ai-structured-streaming.patch"
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "cweagans/composer-patches": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
